# =================================================================
# Media Library & Video Sorter Configuration
# =================================================================

# Path to your main organized media library (destination for sorted videos and gallery view)
# Default: ./data/media
LIBRARY_DIR=/path/to/media/library

# Path to incoming/unsorted video downloads queue
# Default: ./data/incoming
INCOMING_DIR=/path/to/incoming/downloads

# Self-contained runtime data directory (database, thumbnails, transcodes)
# Default: ./data
DATA_DIR=./data

# Optional: Custom SQLite database path (default: ${DATA_DIR}/library.db)
# DB_PATH=./data/library.db

# Optional: Custom thumbnail cache directory (default: ${DATA_DIR}/thumbnails)
# THUMBNAIL_DIR=./data/thumbnails

# Optional: Custom transcode temporary directory (default: ${DATA_DIR}/transcodes)
# TRANSCODE_DIR=./data/transcodes

# Optional: Staging directory for WebP image conversion temporary files (default: ${DATA_DIR}/webp_staging)
# WEBP_STAGING_DIR=./data/webp_staging

# Optional: Staging directory for building library backup snapshots before transfer (default: ${DATA_DIR}/backup_staging)
# BACKUP_STAGING_DIR=./data/backup_staging

# Optional: Library backup directory (saves clean snapshot database & bundled thumbnail archive into the library folder)
# Default: ${LIBRARY_DIR}/.media_library_backup
# LIBRARY_BACKUP_DIR=/path/to/media/library/.media_library_backup
# LIBRARY_BACKUP_SUBDIR=.media_library_backup
# LIBRARY_BACKUP_AUTO_ENABLED=true
# LIBRARY_BACKUP_AUTO_INTERVAL_HOURS=6.0

# Optional: Custom Quick Navigation shortcuts in the browser dialog (comma-separated)
# Default: Home (~), Media Library, Incoming, /media, /mnt
# QUICK_NAV_DIRS=/mnt,/media,~

# Network settings
HOST=0.0.0.0
PORT=8888

# Optional: Single shared password protecting the entire app (all pages and API).
# Leave empty or unset to disable authentication. The cookie is remembered in the
# browser and refreshed on each visit, so you sign in once per browser.
# APP_PASSWORD=changeme

# Optional: Automatic WebP image optimization settings
# WEBP_AUTO_OPTIMIZE=true
# WEBP_WORKER_CONCURRENCY=1
# WEBP_QUALITY=85
# WEBP_SKIP_LARGER=false

# Optional: ZIP staging directory for local assembly before FUSE transfer
# ZIP_STAGING_DIR=./data/zip_staging

# Optional: Staging directory for browser upload chunks (default: ${DATA_DIR}/upload_staging)
# UPLOAD_STAGING_DIR=./data/upload_staging

# Optional: How long an interrupted browser upload keeps its staged chunks, in
# hours, before startup garbage collection removes them (default: 24.0).
# Uploads resume from the staged bytes within this window.
# UPLOAD_STAGING_TTL_HOURS=24.0

# Optional: Ceiling for the extracted animated WebP preview cache in GB
# (default: 5.0). Previews are regenerable, so the least recently written are
# evicted past the cap and regenerated on the next view.
# ANIMATED_CACHE_MAX_SIZE_GB=5.0

# Optional: Local extraction cache directory for ZIP virtual folders (default: ${DATA_DIR}/cache/zips)
# ZIP_CACHE_DIR=./data/cache/zips

# Optional: Maximum local disk cache for extracted ZIP virtual folders in GB (default: 5.0)
# ZIP_CACHE_MAX_SIZE_GB=5.0

# Optional: URL/playlist video downloads (yt-dlp). Downloads land in the
# current library folder via the upload flow; best quality, playlists supported.
# Max parallel downloads (default: 2) and optional cookies file for private or
# age-restricted content (Netscape format, as exported by browser extensions).
# DOWNLOAD_WORKER_CONCURRENCY=2
# DOWNLOAD_COOKIES_FILE=./cookies.txt

# Optional: Global library search result limit (default: 1000)
# Maximum number of matches returned in a single global search query before truncation.
# SEARCH_LIMIT=1000

# Optional: Build revision reported by the /api/health probe. Set this in a
# container or packaged deploy that ships without a .git directory; a plain git
# checkout is detected automatically.
# GIT_COMMIT=

# -----------------------------------------------------------------
# Face recognition ("People") — opt-in, off by default.
# Adds one dependency (opencv-contrib-python-headless) and two ONNX models that
# are downloaded once into ${DATA_DIR}/models (verified by SHA-256). Detection,
# embeddings, clusters and face crops all stay on this machine.
# -----------------------------------------------------------------

# Master switch for the worker, the /people page and the scan endpoints.
# FACE_RECOGNITION_ENABLED=false

# Where the YuNet + SFace .onnx files live (default: ${DATA_DIR}/models)
# FACE_MODEL_DIR=./data/models

# Where the small per-face crop images are cached (default: ${THUMBNAIL_DIR}/faces)
# FACE_CROP_DIR=./data/thumbnails/faces

# Detector score floor (0.1-0.99, default 0.7) and the cosine *distance* ceiling
# for joining an existing person (0.05-1.2, default 0.36; lower is stricter).
# The /people page's Strict/Balanced/Loose control stores its own choice in the
# database, which then wins over FACE_MATCH_THRESHOLD without a restart.
# FACE_DETECTION_CONFIDENCE=0.7
# FACE_MATCH_THRESHOLD=0.36

# Ignore faces smaller than this on the 480px scan image (default 48px), and keep
# at most this many faces per image/frame (default 20, largest first).
# FACE_MIN_FACE_PX=48
# FACE_MAX_PER_FRAME=20

# Video sampling: one frame every N seconds, capped at this many frames
# (defaults 30 and 24), with each hit keeping its timestamp as a "moment".
# FACE_VIDEO_SAMPLE_INTERVAL=30
# FACE_VIDEO_MAX_FRAMES=24

# Ceiling for the face crop cache in GB (default 2.0); crops are regenerable, so
# the oldest are evicted past the cap and their files re-queued.
# FACE_CROP_MAX_SIZE_GB=2.0

