# =================================================================
# Media Library & Video Sorter Configuration
# =================================================================
#
# Every setting below can also be given as an environment variable. Settings are
# read from the environment first and from this file second, so a container can
# export them without a .env at all.
#
# Names are the plain ones. The rewrite shipped with a V2_ prefix while it ran
# beside the previous app; some of those old names (V2_DB_READ_ONLY, V2_OWN_WORKERS,
# V2_UPLOAD_STAGING_DIR, …) are still read as a fallback, so an existing file
# keeps working after upgrading.

# Path to your main organized media library (destination for sorted videos and gallery view)
# Default: ./data/media
LIBRARY_DIR=/path/to/media/library

# Path to the incoming/unsorted video queue the sorter reviews
# Default: ./data/incoming
INCOMING_DIR=/path/to/incoming/downloads

# Self-contained runtime data directory (database, thumbnails, transcodes, staging)
# Default: ./data
DATA_DIR=./data

# Optional: Custom SQLite database path (default: ${DATA_DIR}/library.db)
# DB_PATH=./data/library.db

# Optional: Open the index read-only. Every mutation then answers 503, which is
# useful for a throwaway read-only replica. Default: false
# DB_READ_ONLY=false

# Optional: Master switch for the write endpoints (uploads, rename, move,
# delete, favorites, sorter imports). Default: true
# WRITES=true

# Optional: Custom thumbnail cache directory (default: ${DATA_DIR}/thumbnails)
# THUMBNAIL_DIR=./data/thumbnails

# Optional: Custom transcode temporary directory (default: ${DATA_DIR}/transcodes)
# TRANSCODE_DIR=./data/transcodes

# Optional: Library backup directory (a compacted snapshot database, a poster
# archive and metadata; also what the startup auto-restore reads).
# Default: ${LIBRARY_DIR}/.media_library_backup
# LIBRARY_BACKUP_DIR=/path/to/media/library/.media_library_backup

# Optional: Staging directory for building snapshots before the transfer into
# the library folder (default: ${DATA_DIR}/backup_staging)
# BACKUP_STAGING_DIR=./data/backup_staging

# Network settings
HOST=0.0.0.0
PORT=8888

# Uvicorn log level (debug, info, warning, error, critical). Default: info
LOG_LEVEL=info

# Optional: Single shared password protecting the entire app (all pages and API).
# Leave empty or unset to disable authentication. The cookie is remembered in the
# browser and refreshed on each visit, so you sign in once per browser.
# APP_PASSWORD=changeme

# Optional: Allow the API to restore a snapshot over the live index. Replacing
# the database under running writers is a service-stopped operation, so this
# stays false by default; use `python -m media_library.restore --yes` with the
# service stopped instead. Default: false
# ALLOW_LIVE_RESTORE=false

# Optional: Owned background runtime — the crawler, metadata prober, poster
# sweep, loose-image WebP conversion, duplicate hashing and automatic snapshots.
# Default: true (the app is the only app). Set false for a read-only replica or
# when you drive the index yourself.
# OWN_WORKERS=true
# CRAWL_INTERVAL_MINUTES=30
# BACKUP_INTERVAL_HOURS=6.0

# Optional: Automatic WebP image optimization settings
# WEBP_QUALITY=85
# WEBP_SKIP_LARGER=false

# Optional: In-place H.265 (HEVC) encode settings (default: medium / 18)
# X265_PRESET=medium
# X265_CRF=18

# Optional: Local extraction cache directory for ZIP virtual folders (default: ${DATA_DIR}/cache/zips)
# ZIP_CACHE_DIR=./data/cache/zips

# Optional: Maximum local disk cache for extracted ZIP virtual folders in GB (default: 5.0)
# ZIP_CACHE_MAX_SIZE_GB=5.0

# Optional: Staging directory for browser upload chunks (default: ${DATA_DIR}/upload_staging)
# UPLOAD_STAGING_DIR=./data/upload_staging

# Optional: How long an interrupted browser upload keeps its staged chunks, in
# hours, before startup garbage collection removes them (default: 24.0).
# Uploads resume from the staged bytes within this window.
# UPLOAD_STAGING_TTL_HOURS=24.0

# Optional: URL/playlist video downloads (yt-dlp with a gallery-dl fallback).
# Downloads land in the chosen library folder; best quality, playlists
# supported. Max parallel downloads (default: 2) and an optional cookies file
# for private or age-restricted content (Netscape format, as exported by
# browser extensions).
# DOWNLOAD_WORKER_CONCURRENCY=2
# DOWNLOAD_COOKIES_FILE=./cookies.txt
# DOWNLOAD_STAGING_DIR=./data/download_staging

# Optional: Recent sorter destinations (the undo stack itself is in memory and
# is lost on restart). Default: ${DATA_DIR}/sorter_state.json
# SORTER_STATE=./data/sorter_state.json

# Optional: Incoming folder the sorter reviews. Defaults to INCOMING_DIR.
# SOURCE_DIR=/path/to/incoming/downloads

# Optional: Page sizes for the browse and search endpoints
# BROWSE_LIMIT=120
# SEARCH_LIMIT=1000

# Optional: Build revision reported by the /api/health probe. Set this in a
# container or packaged deploy that ships without a .git directory; a plain git
# checkout is detected automatically.
# GIT_COMMIT=
