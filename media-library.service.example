[Unit]
Description=Media Library & Video Sorter Service
After=network.target

[Service]
Type=simple
User=your-username
WorkingDirectory=/path/to/media-library
# v2 is the app at `/`; `app.py` remains the previous single-file app if you
# ever need to start it explicitly.
ExecStart=/path/to/media-library/venv/bin/python /path/to/media-library/v2_app.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Bound glibc per-thread arenas so repeated image decode/encode across the
# worker threadpool cannot retain large amounts of freed heap.
Environment=MALLOC_ARENA_MAX=2
# Cap memory so a runaway app can only be killed by the cgroup (and auto-restarted),
# never allowed to OOM the whole box. Give a cold full-library re-crawl enough
# headroom that it cannot wedge in kernel memory reclaim under the cap.
MemoryHigh=3G
MemoryMax=5G

[Install]
WantedBy=multi-user.target
